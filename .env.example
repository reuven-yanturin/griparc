# Server only. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
# Preferred: Settings → API Keys → Secret key (sb_secret_...).
SUPABASE_SECRET_KEY=
# Optional fallback for an existing legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random secret, minimum 32 characters; signs form timing challenges.
FORM_SIGNING_SECRET=

# Optional override for the public support/privacy contact.
PRIVACY_CONTACT_EMAIL=support@griparc.site

# Optional server-side PostHog mirroring. Project API key, NOT Personal API key.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
